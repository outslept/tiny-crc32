{
  "name": "tiny-crc32",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.15.0"
}
